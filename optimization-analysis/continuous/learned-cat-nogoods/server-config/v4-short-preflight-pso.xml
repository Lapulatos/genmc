<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 3.0//EN" "https://www.sosy-lab.org/benchexec/benchmark-3.0.dtd">
<benchmark tool="pipeline.tools.genmc_svcomp" timelimit="60 s" memlimit="4 GB" cpuCores="1">
  <option name="--disable-estimation"/>
  <option name="--disable-mm-detector"/>
  <option name="--nthreads=1"/>
  <option name="--v1"/>
  <option name="--cat-stats"/>
  <column title="reasoner-calls">reasoner-calls=([0-9]+)</column>
  <column title="provenance-materializations">provenance-materializations=([0-9]+)</column>
  <column title="warmup-skips">nogood-explanation-warmup-skips=([0-9]+)</column>
  <column title="nogood-learned">nogood-learned=([0-9]+)</column>
  <column title="nogood-match-queries">nogood-match-queries=([0-9]+)</column>
  <column title="nogood-hits">nogood-hits=([0-9]+)</column>
  <rundefinition name="caat-pso.v4-short-preflight">
    <option name="--svcomp-backend=caat-pso"/>
    <tasks name="unreach-call">
      <include>/data3/sujie/svcomp2026-caat/sv-benchmarks/c/pthread/twostage_3.yml</include>
      <propertyfile>/data3/sujie/svcomp2026-caat/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
