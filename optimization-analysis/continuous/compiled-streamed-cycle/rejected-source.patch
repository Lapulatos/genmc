+/* Analysis preserves left-to-right union order while compiling atomic terms and
+ * retaining exact generic fallback for a composition. */
+TEST(CaatOptimizationTest, CompilesOrderedStreamTermsWithGenericFallback)
+{
+	auto analyzed = analyzeModel(R"CAT(CompiledStreamTerms
+let tail = rf ; co
+let order = (po & loc) | (po & [R]) | rf | tail
+acyclic order as cycle
+)CAT");
+	ASSERT_NE(analyzed.model, nullptr);
+	ASSERT_TRUE(analyzed.analysis->lazyCycleRoots()[0].has_value());
+	ASSERT_TRUE(analyzed.analysis->lazyStreamPrograms()[0].has_value());
+	const auto &terms = analyzed.analysis->lazyStreamPrograms()[0]->terms;
+	ASSERT_EQ(terms.size(), 4U);
+	EXPECT_EQ(terms[0].kind, cat::LazyStreamTerm::Kind::FilteredBase);
+	EXPECT_EQ(analyzed.model->predicates()[terms[0].predicate].name, "po");
+	EXPECT_EQ(analyzed.model->predicates()[terms[0].filter].name, "loc");
+	EXPECT_EQ(terms[1].kind, cat::LazyStreamTerm::Kind::FilteredBase);
+	EXPECT_EQ(analyzed.model->predicates()[terms[1].predicate].name, "po");
+	EXPECT_EQ(analyzed.model->predicates()[terms[1].filter].kind,
+		  cat::Predicate::Kind::Identity);
+	EXPECT_EQ(terms[2].kind, cat::LazyStreamTerm::Kind::Base);
+	EXPECT_EQ(analyzed.model->predicates()[terms[2].predicate].name, "rf");
+	EXPECT_EQ(terms[3].kind, cat::LazyStreamTerm::Kind::Generic);
+	EXPECT_EQ(analyzed.model->predicates()[terms[3].predicate].kind,
+		  cat::Predicate::Kind::Composition);
+}
