<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 3.0//EN" "https://www.sosy-lab.org/benchexec/benchmark-3.0.dtd">
<benchmark tool="pipeline.tools.genmc_svcomp" timelimit="60 s" memlimit="4 GB" cpuCores="1">
  <option name="--disable-estimation"/>
  <option name="--disable-mm-detector"/>
  <option name="--nthreads=1"/>
  <option name="--v1"/>
  <option name="--cat-stats"/>
  <column title="executions">Number of complete executions explored: (.*)</column>
  <column title="blocked">Number of blocked executions seen: (.*)</column>
  <column title="preventive-rejected">preventive-rejected=([0-9]+)</column>
  <column title="replay-rejects">preventive-replay-rejects=([0-9]+)</column>
  <column title="replay-mismatches">preventive-replay-mismatches=([0-9]+)</column>
  <column title="counterfactual-consistent">preventive-counterfactual-consistent=([0-9]+)</column>
  <column title="counterfactual-inconsistent">preventive-counterfactual-inconsistent=([0-9]+)</column>
  <column title="direct-reversals">preventive-direct-reversals=([0-9]+)</column>
  <column title="rf-reversals">preventive-rf-reversals=([0-9]+)</column>
  <column title="fr-reversals">preventive-fr-reversals=([0-9]+)</column>
  <column title="co-reversals">preventive-co-reversals=([0-9]+)</column>
  <column title="rmw-reversals">preventive-rmw-reversals=([0-9]+)</column>
  <column title="ineligible">preventive-ineligible=([0-9]+)</column>
  <column title="matched-evals">preventive-matched-evals=([0-9]+)</column>
  <column title="census-ns">preventive-census-ns=([0-9]+)</column>
  <column title="profiled-queries">profiled-queries=([0-9]+)</column>
  <column title="offline-evals">offline-evals=([0-9]+)</column>
  <column title="max-history-base-bytes">max-history-base-bytes=([0-9]+)</column>
  <rundefinition name="caat-pso.preventive-census">
    <option name="--svcomp-backend=caat-pso"/>
    <tasks name="unreach-call">
      <includesfile>/data3/sujie/experiments/caat-optimization/rejection-kernel-census/definitions/paired-pso.set</includesfile>
      <propertyfile>/data3/sujie/svcomp2026-caat/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
