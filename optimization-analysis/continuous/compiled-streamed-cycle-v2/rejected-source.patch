+	/** Compile ordered union/filter terms, leaving unsupported terms exact. */
+	[[nodiscard]] auto compileLazyStream(PredicateId root) const
+		-> std::vector<LazyStreamTerm>
+	{
+		std::vector<LazyStreamTerm> terms;
+		bool removesDispatch{};
+		const auto resolveAlias = [&](PredicateId id) {
+			while (model_.predicates()[id].kind == Predicate::Kind::Alias)
+				id = model_.predicates()[id].operands[0];
+			return id;
+		};
+		auto append = [&](auto &self, PredicateId id) -> void {
+			id = resolveAlias(id);
+			const auto &predicate = model_.predicates()[id];
+			if (predicate.kind == Predicate::Kind::Union) {
+				removesDispatch = true;
+				self(self, predicate.operands[0]);
+				self(self, predicate.operands[1]);
+				return;
+			}
+			if (predicate.kind == Predicate::Kind::Base &&
+			    predicate.type == ValueType::Relation) {
+				terms.push_back({LazyStreamTerm::Kind::Base, id, {}});
+				return;
+			}
+			if (predicate.kind == Predicate::Kind::Identity) {
+				terms.push_back(
+					{LazyStreamTerm::Kind::Identity, predicate.operands[0], {}});
+				return;
+			}
+			if (predicate.kind == Predicate::Kind::Intersection) {
+				const auto cheap = [&](PredicateId operand) {
+					const auto kind = model_.predicates()[operand].kind;
+					return kind == Predicate::Kind::Base ||
+					       kind == Predicate::Kind::Identity;
+				};
+				const auto candidate = cheap(predicate.operands[1])
+						       ? predicate.operands[0]
+						       : predicate.operands[1];
+				const auto filter = candidate == predicate.operands[0]
+						    ? predicate.operands[1]
+						    : predicate.operands[0];
+				const auto resolvedCandidate = resolveAlias(candidate);
+				const auto resolvedFilter = resolveAlias(filter);
+				const auto filterKind = model_.predicates()[resolvedFilter].kind;
+				if (model_.predicates()[resolvedCandidate].kind ==
+					    Predicate::Kind::Base &&
+				    model_.predicates()[resolvedCandidate].type ==
+					    ValueType::Relation &&
+				    (filterKind == Predicate::Kind::Base ||
+				     filterKind == Predicate::Kind::Identity)) {
+					removesDispatch = true;
+					terms.push_back({LazyStreamTerm::Kind::FilteredBase,
+							 resolvedCandidate, resolvedFilter});
+					return;
+				}
+			}
+			terms.push_back({LazyStreamTerm::Kind::Generic, id, {}});
+		};
+		append(append, root);
+		if (!removesDispatch)
+			terms.clear();
+		return terms;
 	}
 
