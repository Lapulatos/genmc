+/** One non-epsilon action in an immutable lazy-cycle program. */
+struct LazyCycleTransition {
+	/** Product-graph action performed while advancing the control state. */
+	enum class Kind : std::uint8_t { SetGuard, Relation, Reset };
+
+	Kind kind{Kind::Relation};
+	std::uint32_t target{};
+	PredicateId predicate{};
+
+	auto operator==(const LazyCycleTransition &) const -> bool = default;
+};
+
+/**
+ * Epsilon-free control program for one exact lazy relation and its reset actions.
+ *
+ * `offsets[state]..offsets[state + 1]` is one flat action row. Epsilon closure,
+ * duplicate elimination and unreachable-state compaction are completed during
+ * analysis. `resetSources[state]` marks rows whose reset action returns to `entry`,
+ * preserving witness projection after exit epsilon paths are fused. The object is
+ * immutable after analysis and safe to share between checker workers.
+ */
+struct LazyCycleAutomaton {
+	std::uint32_t entry{};
+	std::vector<std::uint32_t> offsets;
+	std::vector<LazyCycleTransition> transitions;
+	std::vector<bool> resetSources;
+
+	/** Return the number of compact product-control states. */
+	[[nodiscard]] auto stateCount() const -> std::size_t
+	{
+		return offsets.empty() ? 0 : offsets.size() - 1;
+	}
+};
