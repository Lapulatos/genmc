+	cat::Relation rf(size), co(size);
+	for (std::size_t source = 0; source < middle; ++source)
+		rf.insert(source, middle);
+	for (std::size_t target = middle + 1; target < size; ++target)
+		co.insert(middle, target);
+	const auto result = cat::CaatEvaluator().evaluate(*analyzed.model, *analyzed.analysis, size,
+							  {{"rf", rf}, {"co", co}}, true);
