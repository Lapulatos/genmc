+/** Compile one positive relation expression into a compact epsilon-free program. */
+class LazyCycleAutomatonBuilder {
+public:
+	explicit LazyCycleAutomatonBuilder(const NormalizedModel &model)
+		: model_(model), visiting_(model.predicates().size())
+	{}
+
+	/**
+	 * Return an exact product plan only when it expands a composition.
+	 *
+	 * Intersections remain atomic transitions because their whole-edge filter
+	 * can depend on both endpoints. All failures leave the retained streamed
+	 * interpreter as the caller's exact fallback.
+	 */
+	[[nodiscard]] auto build(PredicateId root) -> std::optional<LazyCycleAutomaton>
+	{
+		const auto fragment = compile(root);
+		if (!valid_ || !expandedComposition_)
+			return std::nullopt;
+		add(fragment.exit, RawTransition::Kind::Reset, fragment.entry);
+		if (!valid_)
+			return std::nullopt;
+		return fuse(fragment.entry);
+	}
+
+private:
+	/** Temporary Thompson edge; epsilon edges never escape immutable analysis. */
+	struct RawTransition {
+		enum class Kind : std::uint8_t { Epsilon, SetGuard, Relation, Reset };
+
+		Kind kind{Kind::Epsilon};
+		std::uint32_t target{};
+		PredicateId predicate{};
+	};
+
+	struct Fragment {
+		std::uint32_t entry{};
+		std::uint32_t exit{};
+	};
+
+	static constexpr std::size_t maxStates = 256;
+
+	[[nodiscard]] auto state() -> std::uint32_t
+	{
+		if (transitions_.size() == maxStates) {
+			valid_ = false;
+			return 0;
+		}
+		transitions_.emplace_back();
+		return static_cast<std::uint32_t>(transitions_.size() - 1);
+	}
+
+	void add(std::uint32_t from, RawTransition::Kind kind, std::uint32_t target,
+		 PredicateId predicate = {})
+	{
+		if (!valid_ || from >= transitions_.size() || target >= transitions_.size()) {
+			valid_ = false;
+			return;
+		}
+		transitions_[from].push_back({kind, target, predicate});
+	}
+
+	[[nodiscard]] auto atomic(PredicateId predicate, RawTransition::Kind kind,
+				  PredicateId operand = {}) -> Fragment
+	{
+		const auto entry = state();
+		const auto exit = state();
+		add(entry, kind, exit, kind == RawTransition::Kind::SetGuard ? operand : predicate);
+		return {entry, exit};
+	}
+
+	/**
+	 * Eliminate epsilon paths, deduplicate actions and discard pure control states.
+	 *
+	 * Each retained state is the entry or a target of a non-epsilon action reachable
+	 * from it. A target's epsilon closure is interpreted in its precompiled row on the
+	 * next product step, preserving the original accepted event-pair language.
+	 */
+	[[nodiscard]] auto fuse(std::uint32_t entry) -> std::optional<LazyCycleAutomaton>
+	{
+		if (entry >= transitions_.size())
+			return std::nullopt;
+		std::vector<std::vector<LazyCycleTransition>> fused(transitions_.size());
+		for (std::uint32_t state = 0; state < transitions_.size(); ++state) {
+			std::vector<bool> closed(transitions_.size());
+			std::vector<std::uint32_t> pending{state};
+			closed[state] = true;
+			while (!pending.empty()) {
+				const auto current = pending.back();
+				pending.pop_back();
+				for (const auto &transition : transitions_[current]) {
+					if (transition.kind == RawTransition::Kind::Epsilon) {
+						if (!closed[transition.target]) {
+							closed[transition.target] = true;
+							pending.push_back(transition.target);
+						}
+						continue;
+					}
+					const auto kind = [&] {
+						switch (transition.kind) {
+						case RawTransition::Kind::SetGuard:
+							return LazyCycleTransition::Kind::SetGuard;
+						case RawTransition::Kind::Relation:
+							return LazyCycleTransition::Kind::Relation;
+						case RawTransition::Kind::Reset:
+							return LazyCycleTransition::Kind::Reset;
+						case RawTransition::Kind::Epsilon:
+							break;
+						}
+						return LazyCycleTransition::Kind::Relation;
+					}();
+					fused[state].push_back(
+						{kind, transition.target, transition.predicate});
+				}
+			}
+			auto &row = fused[state];
+			const auto key = [](const auto &transition) {
+				return std::tuple{transition.kind, transition.target,
+						  transition.predicate};
+			};
+			std::ranges::sort(row, {}, key);
+			row.erase(std::ranges::unique(row).begin(), row.end());
+		}
+
+		std::vector<bool> reachable(transitions_.size());
+		std::vector<std::uint32_t> queue{entry};
+		reachable[entry] = true;
+		for (std::size_t next = 0; next < queue.size(); ++next) {
+			for (const auto &transition : fused[queue[next]]) {
+				if (!reachable[transition.target]) {
+					reachable[transition.target] = true;
+					queue.push_back(transition.target);
+				}
+			}
+		}
+
+		constexpr auto invalid = std::numeric_limits<std::uint32_t>::max();
+		std::vector<std::uint32_t> remap(transitions_.size(), invalid);
+		std::uint32_t stateCount{};
+		for (std::uint32_t state = 0; state < reachable.size(); ++state) {
+			if (reachable[state])
+				remap[state] = stateCount++;
+		}
+		LazyCycleAutomaton result;
+		result.entry = remap[entry];
+		result.offsets.reserve(static_cast<std::size_t>(stateCount) + 1);
+		result.offsets.push_back(0);
+		result.resetSources.assign(stateCount, false);
+		for (std::uint32_t state = 0; state < reachable.size(); ++state) {
+			if (!reachable[state])
+				continue;
+			for (auto transition : fused[state]) {
+				if (remap[transition.target] == invalid)
+					return std::nullopt;
+				transition.target = remap[transition.target];
+				if (transition.kind == LazyCycleTransition::Kind::Reset) {
+					if (transition.target != result.entry)
+						return std::nullopt;
+					result.resetSources[remap[state]] = true;
+				} else if (transition.target == result.entry) {
+					/* Entry must have reset-only incoming edges for exact
+					 * projection. */
+					return std::nullopt;
+				}
+				result.transitions.push_back(transition);
+			}
+			result.offsets.push_back(
+				static_cast<std::uint32_t>(result.transitions.size()));
+		}
+		if (result.stateCount() == 0 ||
+		    result.offsets.back() != result.transitions.size() ||
+		    std::ranges::none_of(result.resetSources, [](bool source) { return source; }))
+			return std::nullopt;
+		return result;
+	}
+
+	/** Duplicate shared expression occurrences so the control graph remains acyclic. */
+	[[nodiscard]] auto compile(PredicateId id) -> Fragment
+	{
+		if (!valid_ || id >= model_.predicates().size() || visiting_[id]) {
+			valid_ = false;
+			return {};
+		}
+		visiting_[id] = true;
+		const auto &predicate = model_.predicates()[id];
+		const auto operandCount = [&](std::size_t count) {
+			if (predicate.operands.size() != count)
+				valid_ = false;
+			return valid_;
+		};
+		Fragment result;
+		switch (predicate.kind) {
+		case Predicate::Kind::Base:
+			if (predicate.type != ValueType::Relation)
+				valid_ = false;
+			else
+				result = atomic(id, RawTransition::Kind::Relation);
+			break;
+		case Predicate::Kind::Alias:
+			if (operandCount(1))
+				result = compile(predicate.operands[0]);
+			break;
+		case Predicate::Kind::Union: {
+			if (!operandCount(2))
+				break;
+			const auto entry = state();
+			const auto exit = state();
+			const auto lhs = compile(predicate.operands[0]);
+			const auto rhs = compile(predicate.operands[1]);
+			add(entry, RawTransition::Kind::Epsilon, lhs.entry);
+			add(entry, RawTransition::Kind::Epsilon, rhs.entry);
+			add(lhs.exit, RawTransition::Kind::Epsilon, exit);
+			add(rhs.exit, RawTransition::Kind::Epsilon, exit);
+			result = {entry, exit};
+			break;
+		}
+		case Predicate::Kind::Composition: {
+			if (!operandCount(2))
+				break;
+			const auto lhs = compile(predicate.operands[0]);
+			const auto rhs = compile(predicate.operands[1]);
+			add(lhs.exit, RawTransition::Kind::Epsilon, rhs.entry);
+			result = {lhs.entry, rhs.exit};
+			expandedComposition_ = true;
+			break;
+		}
+		case Predicate::Kind::Intersection:
+			if (operandCount(2))
+				result = atomic(id, RawTransition::Kind::Relation);
+			break;
+		case Predicate::Kind::Identity:
+			if (operandCount(1))
+				result = atomic(id, RawTransition::Kind::SetGuard,
+						predicate.operands[0]);
+			break;
+		case Predicate::Kind::Optional: {
+			if (!operandCount(1))
+				break;
+			const auto entry = state();
+			const auto exit = state();
+			const auto body = compile(predicate.operands[0]);
+			add(entry, RawTransition::Kind::Epsilon, exit);
+			add(entry, RawTransition::Kind::Epsilon, body.entry);
+			add(body.exit, RawTransition::Kind::Epsilon, exit);
+			result = {entry, exit};
+			break;
+		}
+		default:
+			valid_ = false;
+			break;
+		}
+		visiting_[id] = false;
+		return result;
+	}
+
+	const NormalizedModel &model_;
+	std::vector<bool> visiting_;
+	std::vector<std::vector<RawTransition>> transitions_;
+	bool valid_{true};
+	bool expandedComposition_{};
+};
