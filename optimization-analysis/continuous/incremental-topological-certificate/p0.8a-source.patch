+/* A strict topological certificate skips complete DFS while valid, fails closed when an
+ * insertion violates its order, and remains valid when rollback deletes edges. */
+TEST(IncrementalCaatEvaluatorTest, ReusesLazyTopologicalOrderAcrossInsertionAndRollback)
+{
+	auto analyzed = analyzeModel(R"CAT(IncrementalLazyOrder
+let order = po | (rf ; co)
+acyclic order as cycle
+)CAT");
+	ASSERT_NE(analyzed.model, nullptr);
+	ASSERT_TRUE(analyzed.analysis->lazyCycleRoots()[0].has_value());
+	constexpr std::size_t size = 3;
+	cat::BaseValues empty{{"po", cat::Relation(size)},
+			      {"rf", cat::Relation(size)},
+			      {"co", cat::Relation(size)}};
+	cat::IncrementalCaatEvaluator incremental(*analyzed.model, *analyzed.analysis, true,
+						 true);
+	incremental.initialize(size, empty);
+	ASSERT_TRUE(incremental.result().consistent());
+	ASSERT_EQ(incremental.statistics().lazyCycleChecks, 1U);
+	const auto root = incremental.checkpoint();
+
+	auto firstBranch = empty;
+	std::get<cat::Relation>(firstBranch["po"]).insert(2, 1);
+	ASSERT_TRUE(incremental.tryInsert(size, firstBranch).applied());
+	EXPECT_TRUE(incremental.result().consistent());
+	EXPECT_EQ(incremental.statistics().lazyCycleChecks, 1U);
+
+	auto longer = firstBranch;
+	std::get<cat::Relation>(longer["po"]).insert(1, 0);
+	ASSERT_TRUE(incremental.tryInsert(size, longer).applied());
+	EXPECT_TRUE(incremental.result().consistent());
+	EXPECT_EQ(incremental.statistics().lazyCycleChecks, 1U);
+
+	const auto restored = incremental.rollback(root);
+	ASSERT_TRUE(restored.restored) << restored.reason;
+	EXPECT_TRUE(incremental.result().consistent());
+	auto secondBranch = empty;
+	std::get<cat::Relation>(secondBranch["po"]).insert(2, 0);
+	ASSERT_TRUE(incremental.tryInsert(size, secondBranch).applied());
+	EXPECT_EQ(incremental.statistics().lazyCycleChecks, 1U);
+
+	/* This edge is acyclic but contradicts the cached order, so validation cannot
+	 * decide and the complete DFS must construct a replacement certificate. */
+	auto reordered = secondBranch;
+	std::get<cat::Relation>(reordered["po"]).insert(0, 1);
+	ASSERT_TRUE(incremental.tryInsert(size, reordered).applied());
+	EXPECT_TRUE(incremental.result().consistent());
+	EXPECT_EQ(incremental.statistics().lazyCycleChecks, 2U);
+
+	auto cyclic = reordered;
+	std::get<cat::Relation>(cyclic["po"]).insert(1, 2);
+	ASSERT_TRUE(incremental.tryInsert(size, cyclic).applied());
+	EXPECT_FALSE(incremental.result().consistent());
+	EXPECT_EQ(incremental.statistics().lazyCycleChecks, 3U);
+	const auto materialized =
+		cat::CaatEvaluator().evaluate(*analyzed.model, *analyzed.analysis, size, cyclic);
+	EXPECT_EQ(incremental.result().consistent(), materialized.consistent());
+}
+
 /* Reinitialization atomically replaces the old universe, bases, and result. */
 TEST(IncrementalCaatEvaluatorTest, ReinitializesAfterFallback)
 {
