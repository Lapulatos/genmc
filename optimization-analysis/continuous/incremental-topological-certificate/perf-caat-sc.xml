  <column title="lazy-checks">lazy-cycle-checks=([0-9]+)</column>
  <column title="lazy-candidates">lazy-edge-candidates=([0-9]+)</column>
  <rundefinition name="caat-sc.topological-certificate"><option name="--svcomp-backend=caat-sc"/>
    <tasks name="unreach-call"><includesfile>/data3/sujie/experiments/caat-optimization/packed-from-read/definitions/paired-sc.set</includesfile><propertyfile>/data3/sujie/svcomp2026-caat/sv-benchmarks/c/properties/unreach-call.prp</propertyfile></tasks>
  </rundefinition>
