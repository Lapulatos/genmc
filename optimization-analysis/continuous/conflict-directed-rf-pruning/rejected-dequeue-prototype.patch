+/* Every matched randomized positive explanation still violates a fresh CAAT oracle. */
+RC_GTEST_PROP(CaatLearnedNogoodPropertyTest, MatchedExplanationReplaysViolation,
+	      (const std::vector<std::uint8_t> &edgeBytes))
+{
+	static const auto analyzed = analyzeModel(R"CAT(NogoodReplay
+let rec reach = po | (reach ; po)
+acyclic reach as cycle
+)CAT");
+	RC_ASSERT(analyzed.model != nullptr);
+	const auto size = std::size_t{2} + edgeBytes.size() % 5;
+	SynchronizerTestGraph graph{{nullptr, nullptr, true}};
+	for (std::size_t event = 0; event < size; ++event)
+		addSynchronizerLabel<FenceLabel>(graph, Event(0, static_cast<int>(event + 1)),
+						 MemOrdering::Relaxed);
+	cat::StableGraphAdapter stable({"po"});
+	auto snapshot = stable.materialize(graph);
+	cat::Relation relation(size);
+	for (std::size_t edge = 0; edge < edgeBytes.size(); ++edge) {
+		if ((edgeBytes[edge] & 1U) != 0)
+			relation.insert(edge % size, (edge / size) % size);
+	}
+	relation.insert(0, 1);
+	relation.insert(1, 0);
+	snapshot.base["po"] = relation;
+	auto evaluated = cat::CaatEvaluator().evaluate(*analyzed.model, *analyzed.analysis, size,
+						       snapshot.base);
+	RC_ASSERT(!evaluated.violations.empty());
+	auto explained = cat::Reasoner().explain(*analyzed.model, *analyzed.analysis, size,
+						 evaluated.values, evaluated.violations);
+	RC_ASSERT(explained.ok());
+	RC_ASSERT(!explained.violations.empty());
+	cat::LearnedNogoodDatabase database;
+	RC_ASSERT(database.learn(explained.violations.front(), stable));
+	RC_ASSERT(database.matches(snapshot, stable));
+	auto replay = cat::CaatEvaluator().evaluate(*analyzed.model, *analyzed.analysis, size,
+						    snapshot.base);
+	RC_ASSERT(!replay.violations.empty());
+}
