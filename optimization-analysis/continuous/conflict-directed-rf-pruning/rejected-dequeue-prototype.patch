+template <typename HostChecker>
+auto BasicCATChecker<HostChecker>::isRevisitKnownInconsistent(const ExecutionGraph &graph,
+							      const Revisit &revisit) const -> bool
+{
+	if (!learnedNogoods_ || !graphSynchronizer_)
+		return false;
+	++revisitNogoodQueries_;
+	const auto *readRevisit = genmc::dyn_cast<ReadForwardRevisit>(&revisit);
+	if (!readRevisit || !graph.containsPos(readRevisit->getPos()) ||
+	    (!readRevisit->getRev().isInitializer() && !graph.containsPos(readRevisit->getRev())))
+		return false;
+	const auto *read = graph.getReadLabel(readRevisit->getPos());
+	if (!read)
+		return false;
+	const cat::StableEventKey readKey{readRevisit->getPos()};
+	const cat::StableEventKey sourceKey = readRevisit->getRev().isInitializer()
+						 ? cat::StableEventKey{read->getAddr()}
+						 : cat::StableEventKey{readRevisit->getRev()};
+	if (!graphSynchronizer_->hasRfNogoodCandidate(sourceKey, readKey))
+		return false;
+	++revisitNogoodPrefilterHits_;
+
+	const auto started = std::chrono::steady_clock::now();
+	auto view = graph.getViewFromStamp(read->getStamp());
+	auto prefix = graph.getCopyUpTo(*view);
+	if (!prefix || !prefix->containsPos(readRevisit->getPos()) ||
+	    (!readRevisit->getRev().isInitializer() && !prefix->containsPos(readRevisit->getRev())))
+		return false;
+	auto *prefixRead = prefix->getReadLabel(readRevisit->getPos());
+	auto *prefixSource = readRevisit->getRev().isInitializer()
+				     ? static_cast<EventLabel *>(prefix->getInitLabel())
+				     : prefix->getEventLabel(readRevisit->getRev());
+	if (!prefixRead || !prefixSource)
+		return false;
+	prefixRead->setRf(prefixSource);
+	++revisitNogoodPrefixChecks_;
+	revisitNogoodCopiedLabels_ += static_cast<std::size_t>(std::ranges::distance(prefix->labels()));
+	const auto blocked =
+		graphSynchronizer_->matchesRfNogoodCandidate(*prefix, sourceKey, readKey);
+	revisitNogoodPrefixNanoseconds_ += static_cast<std::uint64_t>(
+		std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() -
+								       started)
+			.count());
+	if (blocked)
+		++revisitNogoodPruned_;
+	return blocked;
+}
