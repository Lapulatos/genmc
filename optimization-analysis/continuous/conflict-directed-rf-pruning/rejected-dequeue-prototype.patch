+/* Positive cycle explanations survive stable-ID universe growth and reject only when
+ * every sufficient primitive fact is present. */
+TEST(CaatLearnedNogoodTest, MatchesPositiveStableExplanation)
+{
+	SynchronizerTestGraph graph{{nullptr, nullptr, true}};
+	addSynchronizerLabel<FenceLabel>(graph, Event(0, 1), MemOrdering::Relaxed);
+	addSynchronizerLabel<FenceLabel>(graph, Event(0, 2), MemOrdering::Relaxed);
+	cat::StableGraphAdapter stable({"po"});
+	auto snapshot = stable.materialize(graph);
+	const auto first = *stable.id(cat::StableEventKey{Event(0, 1)});
+	const auto second = *stable.id(cat::StableEventKey{Event(0, 2)});
+	auto &po = std::get<cat::Relation>(snapshot.base.at("po"));
+	po.insert(second, first);
+	cat::ExplainedViolation explained{
+		{"cycle", cat::Statement::CheckKind::Acyclic, {}, {first, second, first}},
+		{{0, "po", cat::ValueType::Relation, true, first, second},
+		 {0, "po", cat::ValueType::Relation, true, second, first}}};
+	cat::LearnedNogoodDatabase database;
+
+	EXPECT_TRUE(database.learn(explained, stable));
+	EXPECT_TRUE(database.matches(snapshot, stable));
+	po.erase(second, first);
+	EXPECT_FALSE(database.matches(snapshot, stable));
+
+	addSynchronizerLabel<FenceLabel>(graph, Event(0, 3), MemOrdering::Relaxed);
+	auto grown = stable.materialize(graph);
+	std::get<cat::Relation>(grown.base.at("po")).insert(second, first);
+	EXPECT_TRUE(database.matches(grown, stable));
+	EXPECT_EQ(database.statistics().learned, 1U);
+	EXPECT_EQ(database.statistics().hits, 2U);
+	EXPECT_EQ(database.statistics().predicateResolutions, 3U);
+}
