+#include "genmc/CAT/LearnedNogood.hpp"
+
+#include "genmc/Support/Error.hpp"
+
+#include <algorithm>
+#include <numeric>
+#include <tuple>
+
+namespace cat {
+namespace {
+
+static auto literalKey(const StableBaseLiteral &literal)
+{
+	return std::tie(literal.predicate, literal.type, literal.first, literal.second);
+}
+
+static auto literalLess(const StableBaseLiteral &lhs, const StableBaseLiteral &rhs) -> bool
+{
+	return literalKey(lhs) < literalKey(rhs);
+}
+
+} /* namespace */
+
+LearnedNogoodDatabase::LearnedNogoodDatabase(std::size_t clauseLimit, std::size_t literalLimit,
+					     std::size_t explanationAttemptLimit,
+					     bool requireHitCredit)
+	: clauseLimit_(clauseLimit), literalLimit_(literalLimit),
+	  explanationAttemptLimit_(explanationAttemptLimit), requireHitCredit_(requireHitCredit)
+{
+	VERIFY(clauseLimit_ == 0 || literalLimit_ > 0,
+	       "enabled CAT nogood learning requires a positive literal limit");
+}
+
+void LearnedNogoodDatabase::deferNextExplanation(std::size_t requiredHits)
+{
+	if (!requireHitCredit_)
+		return;
+	const auto remaining = std::numeric_limits<std::size_t>::max() - statistics_.hits;
+	nextExplanationHitTarget_ = statistics_.hits + std::min(requiredHits, remaining);
+}
+
+auto LearnedNogoodDatabase::isSubset(const Clause &subset, const Clause &superset) -> bool
+{
+	return std::ranges::includes(superset, subset, literalLess);
+}
+
+auto LearnedNogoodDatabase::storageBytes(const Clause &clause) -> std::size_t
+{
+	return sizeof(Clause) + clause.capacity() * sizeof(StableBaseLiteral);
+}
+
+auto LearnedNogoodDatabase::internPredicate(std::string_view name) -> std::size_t
+{
+	const auto found = std::ranges::find(predicateNames_, name);
+	if (found != predicateNames_.end())
+		return static_cast<std::size_t>(std::distance(predicateNames_.begin(), found));
+	predicateNames_.emplace_back(name);
+	resolvedValues_.push_back(nullptr);
+	return predicateNames_.size() - 1;
+}
+
+void LearnedNogoodDatabase::refreshStorageStatistics()
+{
+	statistics_.currentClauses = clauses_.size();
+	statistics_.currentLiterals = std::accumulate(
+		clauses_.begin(), clauses_.end(), std::size_t{},
+		[](std::size_t count, const auto &clause) { return count + clause.size(); });
+	statistics_.currentBytes = std::accumulate(
+		clauses_.begin(), clauses_.end(), sizeof(*this),
+		[](std::size_t bytes, const auto &clause) { return bytes + storageBytes(clause); });
+	statistics_.currentBytes += predicateNames_.capacity() * sizeof(std::string) +
+				    resolvedValues_.capacity() * sizeof(const Value *) +
+				    std::accumulate(predicateNames_.begin(), predicateNames_.end(),
+						    std::size_t{},
+						    [](std::size_t bytes, const auto &name) {
+							    return bytes + name.capacity();
+						    });
+	statistics_.currentBytes += rfClauseIndex_.size() * sizeof(decltype(rfClauseIndex_)::value_type);
+	for (const auto &[edge, clauses] : rfClauseIndex_) {
+		(void)edge;
+		statistics_.currentBytes += clauses.capacity() * sizeof(std::size_t);
+	}
+	statistics_.maximumClauses =
+		std::max(statistics_.maximumClauses, statistics_.currentClauses);
+	statistics_.maximumLiterals =
+		std::max(statistics_.maximumLiterals, statistics_.currentLiterals);
+	statistics_.maximumBytes = std::max(statistics_.maximumBytes, statistics_.currentBytes);
+}
+
+void LearnedNogoodDatabase::rebuildRfIndex()
+{
+	rfClauseIndex_.clear();
+	const auto found = std::ranges::find(predicateNames_, std::string_view{"rf"});
+	if (found == predicateNames_.end())
+		return;
+	const auto predicate = static_cast<std::size_t>(std::distance(predicateNames_.begin(), found));
+	for (std::size_t clauseIndex = 0; clauseIndex < clauses_.size(); ++clauseIndex) {
+		for (const auto &literal : clauses_[clauseIndex]) {
+			if (literal.predicate != predicate || literal.type != ValueType::Relation ||
+			    !literal.second)
+				continue;
+			rfClauseIndex_[{literal.first, *literal.second}].push_back(clauseIndex);
+		}
+	}
+}
+
+auto LearnedNogoodDatabase::learn(const ExplainedViolation &explained,
+				  const StableGraphAdapter &stable) -> bool
+{
+	if (!wantsExplanation())
+		return false;
+	++statistics_.learnAttempts;
+	if (clauseLimit_ == 0 || explained.explanation.empty() ||
+	    explained.explanation.size() > literalLimit_ ||
+	    (explained.violation.checkKind != Statement::CheckKind::Acyclic &&
+	     explained.violation.checkKind != Statement::CheckKind::Irreflexive)) {
+		++statistics_.unsupported;
+		deferNextExplanation(literalLimit_);
+		return false;
+	}
+
+	for (const auto &literal : explained.explanation) {
+		if (!literal.positive || literal.first >= stable.universeSize() ||
+		    (literal.type == ValueType::Relation &&
+		     (!literal.second || *literal.second >= stable.universeSize())) ||
+		    (literal.type == ValueType::Set && literal.second)) {
+			++statistics_.unsupported;
+			deferNextExplanation(literalLimit_);
+			return false;
+		}
+	}
+	Clause clause;
+	clause.reserve(explained.explanation.size());
+	for (const auto &literal : explained.explanation) {
+		const auto predicate = internPredicate(literal.predicateName);
+		StableBaseLiteral converted{predicate, literal.type, literal.first, std::nullopt};
+		if (literal.second)
+			converted.second = *literal.second;
+		clause.push_back(std::move(converted));
+	}
+	std::ranges::sort(clause, literalLess);
+	clause.erase(std::unique(clause.begin(), clause.end()), clause.end());
+
+	for (const auto &stored : clauses_) {
+		if (!isSubset(stored, clause))
+			continue;
+		if (stored == clause)
+			++statistics_.duplicates;
+		else
+			++statistics_.subsumed;
+		deferNextExplanation(literalLimit_);
+		return false;
+	}
+
+	const auto oldSize = clauses_.size();
+	std::erase_if(clauses_, [&](const auto &stored) { return isSubset(clause, stored); });
+	statistics_.removedSupersets += oldSize - clauses_.size();
+	while (clauses_.size() >= clauseLimit_) {
+		clauses_.erase(clauses_.begin());
+		++statistics_.evicted;
+	}
+	clauses_.push_back(std::move(clause));
+	++statistics_.learned;
+	deferNextExplanation(literalLimit_);
+	rebuildRfIndex();
+	refreshStorageStatistics();
+	return true;
+}
+
+auto LearnedNogoodDatabase::literalMatches(const StableBaseLiteral &literal,
+					   const StableGraphSnapshot &snapshot,
+					   const std::vector<const Value *> &values) -> bool
+{
+	if (literal.first >= snapshot.eventCount || literal.predicate >= values.size())
+		return false;
+	const auto *value = values[literal.predicate];
+	if (!value)
+		return false;
+	if (literal.type == ValueType::Set) {
+		const auto *set = std::get_if<EventSet>(value);
+		return set && set->contains(literal.first);
+	}
+	if (!literal.second)
+		return false;
+	if (*literal.second >= snapshot.eventCount)
+		return false;
+	const auto *relation = std::get_if<Relation>(value);
+	return relation && relation->contains(literal.first, *literal.second);
+}
+
+void LearnedNogoodDatabase::resolvePredicates(const StableGraphSnapshot &snapshot)
+{
+	for (std::size_t predicate = 0; predicate < predicateNames_.size(); ++predicate) {
+		const auto found = snapshot.base.find(predicateNames_[predicate]);
+		resolvedValues_[predicate] = found == snapshot.base.end() ? nullptr
+									  : &found->second;
+		++statistics_.predicateResolutions;
+	}
+}
+
+auto LearnedNogoodDatabase::clauseMatches(const Clause &clause,
+					  const StableGraphSnapshot &snapshot,
+					  std::size_t *candidateChecks) -> bool
+{
+	for (const auto &literal : clause) {
+		++statistics_.literalChecks;
+		if (candidateChecks)
+			++*candidateChecks;
+		if (!literalMatches(literal, snapshot, resolvedValues_))
+			return false;
+	}
+	return true;
+}
+
+auto LearnedNogoodDatabase::matches(const StableGraphSnapshot &snapshot, const StableGraphAdapter &)
+	-> bool
+{
+	++statistics_.matchQueries;
+	resolvePredicates(snapshot);
+	for (const auto &clause : clauses_) {
+		if (!clauseMatches(clause, snapshot))
+			continue;
+		++statistics_.hits;
+		return true;
+	}
+	return false;
+}
+
+auto LearnedNogoodDatabase::stableRfKey(const StableEventKey &source,
+					const StableEventKey &read,
+					const StableGraphAdapter &stable) const
+	-> std::optional<RfKey>
+{
+	const auto sourceId = stable.id(source);
+	const auto readId = stable.id(read);
+	if (!sourceId || !readId)
+		return std::nullopt;
+	return RfKey{*sourceId, *readId};
+}
+
+auto LearnedNogoodDatabase::hasRfCandidate(const StableEventKey &source,
+					   const StableEventKey &read,
+					   const StableGraphAdapter &stable) -> bool
+{
+	++statistics_.rfCandidateQueries;
+	const auto key = stableRfKey(source, read, stable);
+	if (!key || !rfClauseIndex_.contains(*key))
+		return false;
+	++statistics_.rfCandidateIndexHits;
+	return true;
+}
+
+auto LearnedNogoodDatabase::matchesRfCandidate(const StableGraphSnapshot &snapshot,
+					       const StableEventKey &source,
+					       const StableEventKey &read,
+					       const StableGraphAdapter &stable) -> bool
+{
+	++statistics_.rfCandidateMatchQueries;
+	const auto key = stableRfKey(source, read, stable);
+	if (!key)
+		return false;
+	const auto found = rfClauseIndex_.find(*key);
+	if (found == rfClauseIndex_.end())
+		return false;
+	resolvePredicates(snapshot);
+	for (const auto clauseIndex : found->second) {
+		if (clauseIndex >= clauses_.size() ||
+		    !clauseMatches(clauses_[clauseIndex], snapshot,
+				   &statistics_.rfCandidateLiteralChecks))
+			continue;
+		++statistics_.hits;
+		++statistics_.rfCandidateHits;
+		return true;
+	}
+	return false;
+}
+
+} /* namespace cat */

