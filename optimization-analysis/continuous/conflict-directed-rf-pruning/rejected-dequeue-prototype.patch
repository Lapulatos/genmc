+/* The RF index admits only an exact source/read pair and the full clause must still
+ * match before a prospective revisit can be rejected. */
+TEST(CaatLearnedNogoodTest, IndexesAndMatchesExactRfCandidate)
+{
+	SynchronizerTestGraph graph{{nullptr, nullptr, true}};
+	const SAddr x{0x1000};
+	auto *source = addSynchronizerLabel<WriteLabel>(
+		graph, Event(0, 1), MemOrdering::Relaxed, x, ASize(4), SVal(1));
+	source->addCo(graph.getInitLabel());
+	auto *read = addSynchronizerLabel<ReadLabel>(graph, Event(0, 2),
+						    MemOrdering::Relaxed, x, ASize(4));
+	read->setRf(source);
+	cat::StableGraphAdapter stable({"rf", "po"});
+	auto snapshot = stable.materialize(graph);
+	const cat::StableEventKey sourceKey{source->getPos()};
+	const cat::StableEventKey readKey{read->getPos()};
+	const auto sourceId = *stable.id(sourceKey);
+	const auto readId = *stable.id(readKey);
+	cat::ExplainedViolation explained{
+		{"cycle", cat::Statement::CheckKind::Acyclic, {}, {sourceId, readId}},
+		{{0, "rf", cat::ValueType::Relation, true, sourceId, readId},
+		 {0, "po", cat::ValueType::Relation, true, sourceId, readId}}};
+	cat::LearnedNogoodDatabase database;
+
+	EXPECT_TRUE(database.learn(explained, stable));
+	EXPECT_TRUE(database.hasRfCandidate(sourceKey, readKey, stable));
+	EXPECT_FALSE(database.hasRfCandidate(readKey, sourceKey, stable));
+	EXPECT_TRUE(database.matchesRfCandidate(snapshot, sourceKey, readKey, stable));
+	std::get<cat::Relation>(snapshot.base.at("po")).erase(sourceId, readId);
+	EXPECT_FALSE(database.matchesRfCandidate(snapshot, sourceKey, readKey, stable));
+	EXPECT_EQ(database.statistics().rfCandidateQueries, 2U);
+	EXPECT_EQ(database.statistics().rfCandidateIndexHits, 1U);
+	EXPECT_EQ(database.statistics().rfCandidateMatchQueries, 2U);
+	EXPECT_EQ(database.statistics().rfCandidateHits, 1U);
+}
