+	EXPECT_FALSE(database.learn(negative, stable));
+	auto emptyCheck = shortClause;
+	emptyCheck.violation.checkKind = cat::Statement::CheckKind::Empty;
+	EXPECT_FALSE(database.learn(emptyCheck, stable));
