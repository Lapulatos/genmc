+#ifndef GENMC_CAT_LEARNED_NOGOOD_HPP
+#define GENMC_CAT_LEARNED_NOGOOD_HPP
+
+#include "genmc/CAT/Reasoner.hpp"
+#include "genmc/CAT/StableGraphAdapter.hpp"
+
