+/** One compiled positive ground base fact in a worker-stable integer namespace. */
+struct StableBaseLiteral {
+	std::size_t predicate{};
+	ValueType type{ValueType::Relation};
+	std::size_t first{};
+	std::optional<std::size_t> second;
+
+	auto operator==(const StableBaseLiteral &) const -> bool = default;
+};
+
+/** Bounded worker-local learned-nogood observability. */
+struct LearnedNogoodStatistics {
+	std::size_t learnAttempts{};
+	std::size_t explanationBudgetSkips{};
+	std::size_t explanationCreditSkips{};
+	std::size_t learned{};
+	std::size_t unsupported{};
+	std::size_t duplicates{};
+	std::size_t subsumed{};
+	std::size_t removedSupersets{};
+	std::size_t evicted{};
+	std::size_t matchQueries{};
+	std::size_t predicateResolutions{};
+	std::size_t literalChecks{};
+	std::size_t hits{};
+	std::size_t rfCandidateQueries{};
+	std::size_t rfCandidateIndexHits{};
+	std::size_t rfCandidateMatchQueries{};
+	std::size_t rfCandidateLiteralChecks{};
+	std::size_t rfCandidateHits{};
+	std::size_t currentClauses{};
+	std::size_t currentLiterals{};
+	std::size_t currentBytes{};
+	std::size_t maximumClauses{};
+	std::size_t maximumLiterals{};
+	std::size_t maximumBytes{};
+};
+
+/**
+ * Retain sufficient positive CAT explanations across execution-graph candidates.
+ *
+ * Every stored conjunction is matched against materialized primitive values in the
+ * same worker-stable event universe. V1 accepts only positive explanations of cycle or
+ * self-loop violations; insertion of unrelated base facts therefore cannot repair the
+ * witnessed derivation. The database is worker-local, bounded, and not thread-safe.
+ * Eviction loses pruning power only and never affects CAT semantics.
+ */
+class LearnedNogoodDatabase {
+public:
+	/**
+	 * Construct an empty bounded database.
+	 *
+	 * @param clauseLimit Maximum retained clauses; zero disables learning.
+	 * @param literalLimit Maximum literals accepted in one clause; at least one when
+	 * learning is enabled. Also the hit-credit floor when credit is required.
+	 * @param explanationAttemptLimit Maximum optional Reasoner explanations.
+	 * @param requireHitCredit Require realized learned rejections between explanations.
+	 */
+	explicit LearnedNogoodDatabase(
+		std::size_t clauseLimit = 4096, std::size_t literalLimit = 64,
+		std::size_t explanationAttemptLimit = std::numeric_limits<std::size_t>::max(),
+		bool requireHitCredit = false);
+
+	/** Whether another costly Reasoner reconstruction may be requested. */
+	[[nodiscard]] auto wantsExplanation() const -> bool
+	{
+		return statistics_.learnAttempts < explanationAttemptLimit_ &&
+		       (!requireHitCredit_ || statistics_.hits >= nextExplanationHitTarget_);
+	}
+	/** Record why one inconsistent query was evaluated without an explanation. */
+	void noteExplanationSkip()
+	{
+		if (statistics_.learnAttempts >= explanationAttemptLimit_)
+			++statistics_.explanationBudgetSkips;
+		else
+			++statistics_.explanationCreditSkips;
+	}
+
+	/**
+	 * Convert and retain one Reasoner-certified violation explanation.
+	 *
+	 * @param explained Current positive CAT explanation in stable dense IDs.
+	 * @param stable Worker identity map that produced those IDs.
+	 * @return True exactly when a new non-redundant clause was retained.
+	 */
+	[[nodiscard]] auto learn(const ExplainedViolation &explained,
+				 const StableGraphAdapter &stable) -> bool;
+
+	/**
+	 * Test whether one current primitive snapshot entails a retained nogood.
+	 *
+	 * @param snapshot Materialized values in @p stable's ID universe.
+	 * @param stable Identity map matching @p snapshot.
+	 * @return True when every literal of any retained conjunction is present.
+	 * @complexity O(retained clauses * literals) in V1.
+	 */
+	[[nodiscard]] auto matches(const StableGraphSnapshot &snapshot,
+				   const StableGraphAdapter &stable) -> bool;
+	/** Whether a retained clause mentions the exact prospective reads-from edge. */
+	[[nodiscard]] auto hasRfCandidate(const StableEventKey &source,
+					  const StableEventKey &read,
+					  const StableGraphAdapter &stable) -> bool;
+	/** Match only clauses containing one exact prospective reads-from edge. */
+	[[nodiscard]] auto matchesRfCandidate(const StableGraphSnapshot &snapshot,
+					      const StableEventKey &source,
+					      const StableEventKey &read,
+					      const StableGraphAdapter &stable) -> bool;
+
+	/** Return lifetime and current bounded-storage counters. */
+	[[nodiscard]] auto statistics() const -> const LearnedNogoodStatistics &
+	{
+		return statistics_;
+	}
+
+private:
+	using Clause = std::vector<StableBaseLiteral>;
+	using RfKey = std::pair<std::size_t, std::size_t>;
+	[[nodiscard]] static auto isSubset(const Clause &subset, const Clause &superset) -> bool;
+	[[nodiscard]] static auto literalMatches(const StableBaseLiteral &literal,
+						 const StableGraphSnapshot &snapshot,
+						 const std::vector<const Value *> &values) -> bool;
+	[[nodiscard]] static auto storageBytes(const Clause &clause) -> std::size_t;
+	[[nodiscard]] auto internPredicate(std::string_view name) -> std::size_t;
+	[[nodiscard]] auto stableRfKey(const StableEventKey &source, const StableEventKey &read,
+				       const StableGraphAdapter &stable) const
+		-> std::optional<RfKey>;
+	void resolvePredicates(const StableGraphSnapshot &snapshot);
+	[[nodiscard]] auto clauseMatches(const Clause &clause,
+					 const StableGraphSnapshot &snapshot,
+					 std::size_t *candidateChecks = nullptr) -> bool;
+	void rebuildRfIndex();
+	void deferNextExplanation(std::size_t requiredHits);
+	void refreshStorageStatistics();
+
+	std::size_t clauseLimit_{};
+	std::size_t literalLimit_{};
+	std::size_t explanationAttemptLimit_{};
+	bool requireHitCredit_{};
+	std::size_t nextExplanationHitTarget_{};
+	std::vector<std::string> predicateNames_;
+	std::vector<const Value *> resolvedValues_;
+	std::vector<Clause> clauses_;
+	std::map<RfKey, std::vector<std::size_t>> rfClauseIndex_;
+	LearnedNogoodStatistics statistics_;
+};
+
+} /* namespace cat */
+
+#endif /* GENMC_CAT_LEARNED_NOGOOD_HPP */
