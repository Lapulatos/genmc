model SC
node 0 rel builtin rf
node 1 rel builtin fr
node 2 rel union (0,1)
node 3 rel builtin co
node 4 rel union (2,3)
node 5 rel builtin rmw
node 6 rel builtin ext
node 7 rel intersection fre (1,6)
node 8 rel intersection coe (3,6)
node 9 rel composition (7,8)
node 10 rel intersection (5,9)
node 11 rel builtin po
node 12 rel builtin tc
node 13 rel union (11,12)
node 14 rel builtin tj
node 15 rel union (13,14)
node 16 rel union (15,4)
let com = 4
check empty atomicity = 10
check acyclic sc = 16
